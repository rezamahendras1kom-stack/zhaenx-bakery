<%- include('../partials/header') %>

<section class="detailpesanan" id="detailpesanan">
<div class="container">
  <div class="row ">

<% if (error) { %>
  <div class="alert alert-warning mt-3"><%= error %></div>
<% } %>

<% if (success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>

<div class="col-lg-4">
<a href="/pesanan" class="btn btn-sm btn-secondary mb-3">← Kembali ke Riwayat Pesanan</a>
</div>

<div class="card p-4" id="cardss">
  <h3>Pesanan #<%= pesanan.id %></h3>
<div class="s d-flex">
  <p class="text mb-0 me-1">
    <%= new Date(pesanan.tanggal).toLocaleString('id-ID') %> —
    Status:   <p class="text-center m-0 px-1 rounded-3 mb-0 bg-<%= pesanan.status === 'selesai' ? 'success' : pesanan.status === 'diproses' ? 'warning' : pesanan.status === 'dibatalkan' ? 'danger' : 'primary' %>">
    <%= pesanan.status %>
  </p>
  </p>
</div>

  <hr>
<% if (pesanan.status === 'pending') { %>
  <form action="/pesanan/<%= pesanan.id %>/cancel" method="POST" 
        onsubmit="return confirm('Yakin batalkan pesanan ini? Stok akan dikembalikan.')">
    <button class="btn btn-outline-danger">Batalkan Pesanan</button>
  </form>
<% } %>

  <hr>
  <table class="table">
    <thead>
      <tr><th>Produk</th><th>Qty</th><th>Subtotal</th></tr>
    </thead>
    <tbody>
      <% detail.forEach(d => { %>
        <tr>
          <td>
            <div class="d-flex align-items-center">
              <% if (d.gambar) { %>
                <img src="<%= imgUrl(d.gambar) %>" width="50" height="50"
                     style="object-fit:cover;border-radius:6px;" class="me-2">
              <% } %>
             <h4 class="fw-medium"><%= d.nama %></h4> 
            </div>
          </td>
          <td> <p class="align-items-center mb-0">x<%= d.qty %></p></td>
          <td class="rp">Rp <%= d.subtotal.toLocaleString('id-ID') %></td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <% const subtotal = detail.reduce((s, d) => s + d.subtotal, 0); %>
      <% if (pesanan.diskon > 0) { %>
        <tr>
          <th colspan="2" class="text-end">Subtotal :</th>
          <th>Rp <%= subtotal.toLocaleString('id-ID') %></th>
        </tr>
        <tr>
          <th colspan="2" class="text-end text-success">Diskon :</th>
          <th class="text-success">-Rp <%= pesanan.diskon.toLocaleString('id-ID') %></th>
        </tr>
      <% } %>
      <tr>
        <th colspan="2" class="text-end">Total :</th>
        <th>Rp <%= pesanan.total.toLocaleString('id-ID') %></th>
      </tr>
    </tfoot>
  </table>
</div>
</div>
</div>
</section>

<%- include('../partials/footer') %>