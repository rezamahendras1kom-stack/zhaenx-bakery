<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title" id="offcanvasRightLabel">
      <i class="bi bi-cart4 me-2"></i>Keranjang
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <% if (cart.length === 0) { %>
      <h5 class="text-center mt-4">Keranjang masih kosong 🛒</h5>
    <% } else { %>
      <% cart.forEach(item => { %>
        <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
          <% if (item.gambar) { %>
            <img src="<%= imgUrl(item.gambar) %>" width="60" height="60"
                 style="object-fit:cover;border-radius:6px;" class="me-3">
          <% } else { %>
            <div style="width:60px;height:60px;background:#fef3c7;display:flex;align-items:center;justify-content:center;border-radius:6px;margin-right:1rem;">🍰</div>
          <% } %>
          <div class="flex-grow-1">
            <div class="fw-bold small"><%= item.nama %></div>
            <div class="small text-muteds">Rp <%= item.harga.toLocaleString('id-ID') %> × <%= item.qty %></div>
            <div class="small fw-bold text-warning">Rp <%= item.subtotal.toLocaleString('id-ID') %></div>
          </div>
          <form action="/keranjang/hapus" method="POST">
            <input type="hidden" name="produk_id" value="<%= item.produk_id %>">
            <button class="btn btn-sm btn-outline-danger" type="submit" title="Hapus">
              <i class="bi bi-x-lg"></i>
            </button>
          </form>
        </div>
      <% }) %>
      <div class="d-grid gap-2 mt-4">
        <a href="/keranjang" class="btn btn-outline-warning">Lihat Keranjang</a>
        <a href="/pesanan/checkout" class="btn btn-warning">Checkout</a>
      </div>
    <% } %>
  </div>
</div>